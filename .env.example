# Lokale Entwicklung. Niemals echte Werte committen.
# SECRET_KEY und PASSPHRASE müssen in Produktion gesetzt werden
# (DEBUG=False oder RENDER=True); leere Werte verhindern dort den Start.
# SECRET_KEY erzeugen: python -c "import secrets; print(secrets.token_urlsafe(50))"
# PASSPHRASE erzeugen: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Für stabile Sessions SECRET_KEY und PASSPHRASE über Neustarts/Worker beibehalten.
SECRET_KEY=
# PASSPHRASE muss ein eigener geheimer Wert sein, kein Repository-Beispielwert.
# Nur mit DEBUG=True und ohne Render: leer -> Zufallswert (32 Bytes) pro Settings-Laden;
# dieser temporäre Wert erscheint als WARNING in der Startkonsole, niemals in Produktion.
PASSPHRASE=
DEBUG=True
PASSPHRASE_GATE_ENABLED=True
AUTOSTART_BOTS=True

# Live-Handel API-Schlüssel (nur beim Container-Start benötigt, nie in der DB speichern).
# Für Paper-Trading leer lassen.
EXCHANGE_API_KEY=replace-with-your-api-key
EXCHANGE_SECRET_KEY=replace-with-your-secret-key

# Optional: Ohne DATABASE_URL wird lokal SQLite verwendet.
# DATABASE_URL=postgresql://user:password@localhost:5432/tbot
# Hinweis: Der lokale Docker-Stack (docker-compose.yml) verlangt SECRET_KEY,
# PASSPHRASE und POSTGRES_PASSWORD als Pflichtwerte ohne Defaults.
# Vorlage mit Erzeugungshinweisen: .env.docker.example
# DATABASE_POOL_URL=postgresql://user:password@pooler:5432/tbot
# USE_DIRECT_DATABASE_URL=False
# DATABASE_SSL_REQUIRE=False
# Optionaler, explizit geprüfter zweiter libpq-Host:
# DATABASE_FALLBACK_HOST=dpg-example-a.frankfurt-postgres.render.com
# BOT_DB_WORKERS=1
# DB_RECONNECT_MAX_RETRIES=5
# DB_RECONNECT_BASE_DELAY=1
# DB_RECONNECT_MAX_DELAY=30
# DB_CIRCUIT_BREAKER_SECONDS=300
# DATA_LOG_WRITE_INTERVAL_SECONDS=10
# BOT_CONFIG_REFRESH_SECONDS=30
# Absolute Backtest-Sicherheitsgeländer (Hardwareprofil kann weiter reduzieren)
# BACKTEST_MAX_COMBINATIONS=20000
# BACKTEST_MAX_PRICE_POINTS=5000
# BACKTEST_DEFAULT_PRICE_POINTS=5000

# Optional für bezahlte/extern betriebene Redis- und Celery-Worker.
# REDIS_URL=redis://localhost:6379/0

# Zusätzliche Hosts/Origins, kommasepariert.
# DJANGO_ALLOWED_HOSTS=example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# Nur verifizierte Peer-IPs/CIDRs eigener Reverse-Proxys, kommasepariert.
# Ohne Allowlist wird X-Forwarded-For beim Auth-Rate-Limit ignoriert.
# Proxy muss die tatsächliche Client-IP anhängen oder den Header überschreiben.
# RATE_LIMIT_TRUSTED_PROXIES=192.0.2.10/32
