# Nach .env kopieren und geheime Werte dort ersetzen.
# Der lokale Docker-Stack läuft standardmäßig ohne Passphrase-Gate.
# Alle drei Secrets müssen vor `docker compose up` privat gesetzt werden,
# auch bei lokal deaktiviertem Gate: Fehlende oder leere Werte brechen die
# Compose-Interpolation ab (keine öffentlichen Defaults mehr, SEC-12).
# Alternativ: scripts/setup_local.sh --no-up
# SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(50))"
# PASSPHRASE: python -c "import secrets; print(secrets.token_urlsafe(32))"
# POSTGRES_PASSWORD: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
PASSPHRASE=
# Nur für isolierte lokale Entwicklung. Für Teamzugriff True setzen;
# Render und DEBUG=False erlauben keinen deaktivierten Gate.
PASSPHRASE_GATE_ENABLED=False
# Optional: verifizierte Proxy-Peer-IPs/CIDRs, niemals pauschal alle Netze vertrauen.
# RATE_LIMIT_TRUSTED_PROXIES=192.0.2.10/32
AUTOSTART_BOTS=True
POSTGRES_DB=tbot
POSTGRES_USER=tbot
# Pflichtwert ohne Default: leer lassen schlägt beim Compose-Start fehl.
# Postgres liest das Passwort nur beim ersten Volume-Init; eine spätere
# Änderung erfordert scripts/setup_local.sh --reset-db (siehe docs/FAQ.md).
POSTGRES_PASSWORD=
WEB_PORT=8369

# Optional: scripts/tune_local_hardware.py berechnet passendere Werte.
SIMULATE_RENDER_FREE=False
WEB_CPUS=1.25
WORKER_CPUS=1.50
POSTGRES_CPUS=0.60
REDIS_CPUS=0.20
SCHEDULER_CPUS=0.20
WEB_MEMORY=1024m
WORKER_MEMORY=768m
POSTGRES_MEMORY=512m
REDIS_MEMORY=128m
SCHEDULER_MEMORY=192m

# Backtest-Geländer: Hardwareprofil kann diese Werte weiter reduzieren.
BACKTEST_MAX_COMBINATIONS=20000
BACKTEST_MAX_PRICE_POINTS=5000
BACKTEST_DEFAULT_PRICE_POINTS=5000
DATA_LOG_WRITE_INTERVAL_SECONDS=5
CELERY_LOG_LEVEL=INFO

# Redis/PostgreSQL-Defaults für kleine lokale Installationen.
REDIS_MAXMEMORY=96mb
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_SHARED_BUFFERS_MB=128
POSTGRES_EFFECTIVE_CACHE_MB=384
POSTGRES_WORK_MEM_MB=8
