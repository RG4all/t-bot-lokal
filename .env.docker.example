# Copy to .env before `docker compose up --build`.
SECRET_KEY=replace-with-a-long-local-secret
PASSPHRASE=local-t-bot
PASSPHRASE_GATE_ENABLED=True
AUTOSTART_BOTS=True
POSTGRES_DB=tbot
POSTGRES_USER=tbot
POSTGRES_PASSWORD=replace-with-a-local-db-password
WEB_PORT=8000

# Native local defaults. Prefer scripts/tune_local_hardware.py for auto-tuning.
# Render-Free simulation is OFF unless explicitly requested.
SIMULATE_RENDER_FREE=False
WEB_CPUS=1.25
WORKER_CPUS=1.50
POSTGRES_CPUS=0.60
REDIS_CPUS=0.20
SCHEDULER_CPUS=0.20
WEB_MEMORY=1024m
WORKER_MEMORY=768m
POSTGRES_MEMORY=512m
REDIS_MEMORY=128m
SCHEDULER_MEMORY=192m
REDIS_MAXMEMORY=96mb
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=384MB
BACKTEST_DEFAULT_PRICE_POINTS=5000
DATA_LOG_WRITE_INTERVAL_SECONDS=5
CELERY_LOG_LEVEL=INFO

# Optionale Speicher-Limits (Container-Mem) und Tuning-Overrides.
# Wenn nicht gesetzt, berechnet hardware-test.sh passende Werte anhand der
# Host-Ressourcen und schreibt sie in das gemeinsam genutzte Volume.
REDIS_MAXMEMORY=48mb
REDIS_MEMORY=96m
POSTGRES_MEMORY=256m
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_SHARED_BUFFERS_MB=32
POSTGRES_EFFECTIVE_CACHE_MB=128
POSTGRES_WORK_MEM_MB=4
